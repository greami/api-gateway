{
  "info": {
    "name": "PrenotazioneController",
    "_postman_id": "8d0f2f1b-7f49-4a1f-8d22-6a7c2a8f3c01",
    "description": "Collection for calling PrenotazioneController endpoints without authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Crea prenotazione",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idUtente\": 1001,\n  \"idEvento\": 100001,\n  \"numeroPartecipanti\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/prenotazioni"
        }
      }
    },
    {
      "name": "Cerca prenotazione per ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/prenotazioni/{{idPrenotazione}}"
        }
      }
    },
    {
      "name": "Cerca prenotazioni per evento",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/eventi/{{idEvento}}/prenotazioni"
        }
      }
    },
    {
      "name": "Modifica prenotazione",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numeroPartecipanti\": 4\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/prenotazioni/{{idPrenotazione}}"
        }
      }
    },
    {
      "name": "Cancella prenotazione",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/prenotazioni/{{idPrenotazione}}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "idPrenotazione",
      "value": "1000"
    },
    {
      "key": "idEvento",
      "value": "100000"
    }
  ]
}
