@startuml
allowmixing
title Diagramma delle classi - API Gateway
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "Adapter" {
  package "API REST (generated)" {
    interface AuthApi
    interface EventiApi
    interface OpereApi
    interface EventoOperaApi
    interface FeedbackEventiApi
    interface FeedbackOpereApi
    interface PrenotazioniApi
    interface UtentiApi
    interface RuoliApi
    interface UtenteRuoliApi
  }

  package "Porta in - controller REST" {
    class AuthController
    class EventiController
    class OpereController
    class EventoOperaController
    class FeedbackEventiController
    class FeedbackOpereController
    class PrenotazioniController
    class UtentiController
    class RuoliController
    class UtenteRuoliController
  }

  package "Porta out - servizi remoti" {
    class CoreServiceAdapter
    class UserServiceAdapter
    class GatewayResponseMapper
  }

  package "Client Feign" {
    interface CoreServiceClient
    interface UserServiceClient
  }

  class SpringResponseEntity <<Spring HTTP>>

  package "Sicurezza" {
    class SecurityConfig
    class JwtAuthenticationFilter
    class CustomUserDetailsService
    class JwtService
    interface SpringUserDetailsService <<Spring Security>>
    class SpringUserDetails <<Spring Security>>
  }

  class ApplicationConfig
}

package "Application" {
  package "Porte in - use case" {
    interface AuthenticationUseCase
    interface LoadUserUseCase
    interface EventsUseCase
    interface WorksUseCase
    interface EventWorksUseCase
    interface EventFeedbackUseCase
    interface WorkFeedbackUseCase
    interface BookingsUseCase
    interface UsersUseCase
    interface RolesUseCase
    interface UserRolesUseCase
  }

  package "Porte out" {
    interface CoreServicePort
    interface UserServicePort
    interface JwtTokenPort
  }

  package "Servizi applicativi" {
    class AuthenticationService
    class CoreGatewayService
    class UserGatewayService
  }

  package "Modelli applicativi" {
    class GatewayResponse~T~ <<record>>
    class AuthenticatedUser <<record>>
  }

  package "Exception" {
    class UnknownUserException
  }

  package "Modelli OpenAPI condivisi (generated)" {
    class AuthRequest
    class AuthResponse
    class RegistraRequest
    class UtenteResponse
    class UtenteConRuoliResponse
    class Evento
    class Opera
    class EventoOpera
    class FeedbackEventi
    class FeedbackOpere
    class Prenotazione
  }
}

package "Domain" {
  package "Model" {
    class UserAccount <<record>> {
      id: Integer
      username: String
      password: String
      roleIds: List<Integer>
      --
      +authorities(): List<String>
    }
    class RolePolicy {
      {static} +authoritiesFor(roleIds): List<String>
    }
  }

  package "Exception" {
    class InvalidCredentialsException
    class UserNotFoundException
  }
}

cloud "Core Service" as CoreService
cloud "User Service" as UserService

' Generated REST interfaces are implemented by their MVC controllers.
AuthController ..|> AuthApi
EventiController ..|> EventiApi
OpereController ..|> OpereApi
EventoOperaController ..|> EventoOperaApi
FeedbackEventiController ..|> FeedbackEventiApi
FeedbackOpereController ..|> FeedbackOpereApi
PrenotazioniController ..|> PrenotazioniApi
UtentiController ..|> UtentiApi
RuoliController ..|> RuoliApi
UtenteRuoliController ..|> UtenteRuoliApi

' Inbound adapters depend only on the use cases they expose.
AuthController --> AuthenticationUseCase
EventiController --> EventsUseCase
OpereController --> WorksUseCase
EventoOperaController --> EventWorksUseCase
FeedbackEventiController --> EventFeedbackUseCase
FeedbackOpereController --> WorkFeedbackUseCase
PrenotazioniController --> BookingsUseCase
UtentiController --> UsersUseCase
RuoliController --> RolesUseCase
UtenteRuoliController --> UserRolesUseCase
AuthController ..> GatewayResponseMapper
EventiController ..> GatewayResponseMapper
OpereController ..> GatewayResponseMapper
EventoOperaController ..> GatewayResponseMapper
FeedbackEventiController ..> GatewayResponseMapper
FeedbackOpereController ..> GatewayResponseMapper
PrenotazioniController ..> GatewayResponseMapper
UtentiController ..> GatewayResponseMapper
RuoliController ..> GatewayResponseMapper
UtenteRuoliController ..> GatewayResponseMapper

' Application services implement inbound ports and call outbound ports.
AuthenticationService ..|> AuthenticationUseCase
AuthenticationService ..|> LoadUserUseCase
CoreGatewayService ..|> EventsUseCase
CoreGatewayService ..|> WorksUseCase
CoreGatewayService ..|> EventWorksUseCase
CoreGatewayService ..|> EventFeedbackUseCase
CoreGatewayService ..|> WorkFeedbackUseCase
CoreGatewayService ..|> BookingsUseCase
UserGatewayService ..|> UsersUseCase
UserGatewayService ..|> RolesUseCase
UserGatewayService ..|> UserRolesUseCase
AuthenticationService --> UserServicePort
AuthenticationService --> JwtTokenPort
AuthenticationService ..> UserAccount
AuthenticationService ..> AuthenticatedUser
AuthenticationService ..> UnknownUserException
AuthenticationService ..> InvalidCredentialsException
AuthenticationService ..> UserNotFoundException
AuthenticationService ..> GatewayResponse
CoreGatewayService --> CoreServicePort
CoreGatewayService ..> GatewayResponse
UserGatewayService --> UserServicePort
UserGatewayService ..> GatewayResponse

' Outbound adapters implement application ports and wrap Feign clients.
CoreServiceAdapter ..|> CoreServicePort
CoreServiceAdapter --> CoreServiceClient
UserServiceAdapter ..|> UserServicePort
UserServiceAdapter --> UserServiceClient
CoreServiceAdapter ..> GatewayResponseMapper
UserServiceAdapter ..> GatewayResponseMapper
GatewayResponseMapper ..> GatewayResponse
GatewayResponseMapper ..> SpringResponseEntity
CoreServiceClient --> CoreService
UserServiceClient --> UserService

' JWT and Spring Security remain adapter concerns.
JwtService ..|> JwtTokenPort
JwtService ..> SpringUserDetails
CustomUserDetailsService ..|> SpringUserDetailsService
CustomUserDetailsService --> LoadUserUseCase
CustomUserDetailsService ..> AuthenticatedUser
CustomUserDetailsService ..> UnknownUserException
JwtAuthenticationFilter --> JwtService
JwtAuthenticationFilter --> CustomUserDetailsService
SecurityConfig --> JwtAuthenticationFilter
SecurityConfig --> CustomUserDetailsService

' Domain role policy is applied while creating the domain account.
UserAccount ..> RolePolicy

' Spring configuration wires the application services to outbound ports.
ApplicationConfig ..> AuthenticationService
ApplicationConfig ..> CoreGatewayService
ApplicationConfig ..> UserGatewayService
ApplicationConfig ..> CoreServicePort
ApplicationConfig ..> UserServicePort
ApplicationConfig ..> JwtTokenPort

note left of UserAccount
Il ruolo con ID 2 produce ROLE_ADMIN;
gli altri utenti ricevono ROLE_USER.
end note

note bottom of CoreService
micro servizio core-service
end note

note bottom of UserService
micro servizio user-service
end note

@enduml
